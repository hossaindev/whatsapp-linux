{
  "name": "whatsapp-linux",
  "version": "1.4.0",
  "description": "WhatsApp Desktop for Linux by Meta",
  "author": "WhatsApp LLC <support@whatsapp.com>",
  "homepage": "https://whatsapp.com",
  "main": "src/main.js",
  "dependencies": {
    "dbus-next": "^0.10.2"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "build": "electron-builder --linux deb --x64"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.whatsapp.linux",
    "productName": "WhatsApp",
    "executableName": "whatsapp",
    "compression": "maximum",
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Network;InstantMessaging;Chat",
      "icon": "assets/icons",
      "maintainer": "WhatsApp LLC <support@whatsapp.com>",
      "synopsis": "Official WhatsApp Desktop for Linux",
      "description": "Fast, simple, secure messaging and calling for Linux desktop.",
      "artifactName": "WhatsApp_${version}_amd64.deb",
      "desktop": {
        "entry": {
          "StartupWMClass": "whatsapp",
          "GenericName": "Internet Messenger",
          "Keywords": "whatsapp;chat;im;messaging;meta;voice;video;"
        }
      }
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "deb": {
      "compression": "xz",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  },
  "desktopName": "whatsapp.desktop"
}
